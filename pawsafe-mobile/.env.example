# Public runtime configuration. Every EXPO_PUBLIC_ value is embedded in the
# client bundle and must be safe for anyone to read.
# iOS Simulator can reach the backend on the Mac through 127.0.0.1.
# Android Emulator uses http://10.0.2.2:8000 instead.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Never add Kakao REST credentials, FastAPI secrets, or Google Maps keys as
# EXPO_PUBLIC_ variables. GOOGLE_MAPS_ANDROID_API_KEY, when needed for an EAS
# Android build, must be supplied as a private local/EAS build environment value.
