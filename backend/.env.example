APP_ENV=development
APP_NAME=PawSafe API
API_PREFIX=/v1

# Shared runtime data. These are the only paths the API needs locally.
ANALYSIS_PROVIDER=pawsafe_12day
HEAT_COST_PROVIDER=file
PLACE_PROVIDER=mock
SHORTEST_ROUTE_PROVIDER=internal_graph
GRAPH_FILE_PATH=data/exports/walk_graph.gpkg
HEAT_COST_FILE_PATH=data/exports/edge_heat_cost.json
COVERAGE_FILE_PATH=data/exports/coverage.geojson
WALK_MODE_CONFIG_PATH=app/config_data/walk_modes.live.yaml
PIPELINE_DATA_VERSION=live
PIPELINE_TIMEZONE=Asia/Seoul
PAWSAFE_12DAY_CONFIG_PATH=data/models/pawsafe_12day/config.json

# Weather and place providers. Keep all credentials in this file only.
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=
ASOS_SERVICE_KEY=
ASOS_STATION_ID=108
# latest: latest D-1 complete 09:00-21:00 ASOS window / fixed: 2026-08-15 16:00 demo
PAWSAFE_ASOS_INFERENCE_MODE=latest
PAWSAFE_ASOS_FIXED_TIMESTAMP=2026-08-15T16:00:00

ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:8000
REQUEST_TIMEOUT_SECONDS=10
ROUTE_ANALYSIS_TIMEOUT_SECONDS=60
PLACE_SEARCH_TIMEOUT_SECONDS=5
WALKING_SPEED_M_PER_MINUTE=70
MIN_LOCATION_DISTANCE_M=10
MAX_NODE_MATCH_DISTANCE_M=150
MAX_ROUTE_SEARCH_DISTANCE_M=10000
MAX_HEAT_DATA_AGE_MINUTES=120
HEAT_MISSING_POLICY=exclude
CONSERVATIVE_MISSING_HEAT_COST=100
LOG_LEVEL=INFO
LOG_PRECISE_LOCATIONS=false
