APP_ENV=development
APP_NAME=PawSafe API
API_PREFIX=/v1

ANALYSIS_PROVIDER=graph
HEAT_COST_PROVIDER=file
# Places are fixed coordinate fixtures for the MVP.
PLACE_PROVIDER=mock
SHORTEST_ROUTE_PROVIDER=internal_graph

GRAPH_FILE_PATH=app/fixtures/demo_graph.geojson
HEAT_COST_FILE_PATH=app/fixtures/demo_heat_cost.json
# Optional private pipeline inputs. Keep these files outside Git and outside
# the Docker build context. Set ANALYSIS_PROVIDER=graph and
# HEAT_COST_PROVIDER=file to enable them locally.
PIPELINE_GRAPH_FILE_PATH=data/exports/walk_graph.gpkg
PIPELINE_HEAT_COST_FILE_PATH=data/exports/edge_heat_cost.json
PIPELINE_WALK_MODE_CONFIG_PATH=app/config_data/walk_modes.live.yaml
PIPELINE_DATA_VERSION=live
PIPELINE_TIMEZONE=Asia/Seoul
COVERAGE_FILE_PATH=data/exports/coverage.geojson
WALK_MODE_CONFIG_PATH=app/config_data/walk_modes.demo.yaml
MOCK_SCENARIOS_FILE_PATH=app/fixtures/demo_scenarios.json
MOCK_PLACES_FILE_PATH=app/fixtures/demo_places.json

ANALYSIS_EXTERNAL_URL=
HEAT_COST_EXTERNAL_URL=
SHORTEST_ROUTE_EXTERNAL_URL=
# Required when PLACE_PROVIDER=kakao.
# Never put this key in the mobile .env.
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=
ASOS_SERVICE_KEY=
ASOS_STATION_ID=108

ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
REQUEST_TIMEOUT_SECONDS=10
PLACE_SEARCH_TIMEOUT_SECONDS=5

WALKING_SPEED_M_PER_MINUTE=70
MIN_LOCATION_DISTANCE_M=10
MAX_NODE_MATCH_DISTANCE_M=150
MAX_ROUTE_SEARCH_DISTANCE_M=10000
MAX_HEAT_DATA_AGE_MINUTES=120
HEAT_MISSING_POLICY=exclude
CONSERVATIVE_MISSING_HEAT_COST=100

LOG_LEVEL=INFO
LOG_PRECISE_LOCATIONS=false
