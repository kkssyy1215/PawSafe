APP_ENV=development
APP_NAME=온:길 API
API_PREFIX=/v1

# Final GMM route runtime.
ANALYSIS_PROVIDER=ongil_gmm
PLACE_PROVIDER=catalog
COVERAGE_FILE_PATH=data/exports/coverage.geojson
SUPPORTED_PLACES_FILE_PATH=data/supported_places.json
ONGIL_GMM_MODEL_PATH=data/models/ongil_gmm_0815_1600

# Optional endpoints only. The final route model does not use these keys.
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=
ASOS_SERVICE_KEY=
ASOS_STATION_ID=108

ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:8000
REQUEST_TIMEOUT_SECONDS=10
ROUTE_ANALYSIS_TIMEOUT_SECONDS=60
PLACE_SEARCH_TIMEOUT_SECONDS=5
WALKING_SPEED_M_PER_MINUTE=70
MIN_LOCATION_DISTANCE_M=10
MAX_NODE_MATCH_DISTANCE_M=150
MAX_ROUTE_SEARCH_DISTANCE_M=10000
LOG_LEVEL=INFO
LOG_PRECISE_LOCATIONS=false
